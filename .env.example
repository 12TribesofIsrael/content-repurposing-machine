# Copy this file to .env and fill in all values
# Never commit .env to git

# OpenAI (for n8n AI content generation)
OPENAI_API_KEY=

# Gmail (for approval email sending via n8n)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# LinkedIn (for n8n LinkedIn posting)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Meta / Facebook + Instagram
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ID=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# n8n (if self-hosting)
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=

# Client config
CLIENT_NAME=
CLIENT_EMAIL=
CLIENT_APPROVAL_EMAIL=
