# Branch 2 Text Layer -- per-client credentials.
#
# These are loaded into a Modal Secret, NOT committed to git.
# Workflow per client:
#   1. cp .env.example .env  (then fill in)
#   2. modal secret create content-<client-name>-secrets --from-dotenv .env
#   3. rm .env
#
# Anything you omit -> that platform/feature is skipped at publish time
# (logged as "skip: missing env: ...").  The pipeline does not fail.

# ----------------------------------------------------------------------------
# Required: LLM + image gen
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ----------------------------------------------------------------------------
# Required: Modal public URL (filled in after first `modal deploy`)
# Used in approval emails for the one-click "Approve & publish" link.
# Format: https://<workspace>--content-repurposing-<client>-approve.modal.run
# ----------------------------------------------------------------------------
MODAL_PUBLIC_URL=

# ----------------------------------------------------------------------------
# Required: Gmail OAuth for approval emails
#
# GMAIL_TOKEN_JSON = the full contents of token.json as a single string.
# Reuse the existing aibiblegospels444 token at:
#   C:/Users/Owner/.claude/skills/gmail-inbox/token_aibiblegospels444.json
# (scopes must include gmail.send or gmail.modify)
#
# GMAIL_SENDER = the From: header.  Use "me" to default to the token owner.
# ----------------------------------------------------------------------------
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.send","https://www.googleapis.com/auth/gmail.modify"]}
GMAIL_SENDER=me

# ----------------------------------------------------------------------------
# Optional: WordPress (set to publish the blog post automatically)
#   App password = WP-Admin -> Users -> Profile -> Application Passwords
# ----------------------------------------------------------------------------
WORDPRESS_URL=https://client-site.com
WORDPRESS_USER=admin
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ----------------------------------------------------------------------------
# Optional: Twitter / X  (api.x.com)
#   Create app at developer.x.com -> Project & Apps -> Keys and tokens
# ----------------------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ----------------------------------------------------------------------------
# Optional: LinkedIn
#   LINKEDIN_ACTOR_URN = urn:li:person:<id>  (personal profile)
#                    OR urn:li:organization:<id>  (company page)
#   Token must have w_member_social or w_organization_social scope.
# ----------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ACTOR_URN=

# ----------------------------------------------------------------------------
# Optional: Facebook Page (Graph API)
#   Long-lived Page access token + page id.
#   Get from developers.facebook.com -> Graph API Explorer.
# ----------------------------------------------------------------------------
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# ----------------------------------------------------------------------------
# Optional: Instagram Business (Graph API)
#   Requires the IG account to be Business / Creator AND linked to a
#   Facebook Page.  IG_BUSINESS_ACCOUNT_ID is the IG-side numeric id.
#
# IMGBB_API_KEY is used as a free public-URL host for graphics, because
# IG Graph API requires a publicly fetchable image_url.  Swap for your own
# host (Cloudinary, S3, Modal-served endpoint) if preferred.
#   Get a free key: api.imgbb.com -> About -> API
# ----------------------------------------------------------------------------
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IMGBB_API_KEY=

# ----------------------------------------------------------------------------
# Optional: Pinterest (API v5)
#   PINTEREST_BOARD_ID = the board to pin into.
#   Token must have boards:read, pins:write scopes.
# ----------------------------------------------------------------------------
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
